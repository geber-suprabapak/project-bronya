# project-bronya: Kiosk Attendance Scanning Terminal
# Copy this file to .env and replace every value marked `replace-me`.

NODE_ENV=production
PORT=3000

# Astra BFF. Bronya forwards the current authenticated Logto access token.
# Bronya runs in its own compose network, so it reaches the production stack
# through the host's published ports rather than `localhost`.
ASTRA_API_URL=http://192.168.21.121:23000

# Logto OIDC application
LOGTO_ENDPOINT=http://192.168.21.121:23001
LOGTO_APP_ID=bronya-app
LOGTO_APP_SECRET=replace-me
LOGTO_COOKIE_SECRET=replace-with-a-random-secret-at-least-32-characters
LOGTO_BASE_URL=http://192.168.21.121:15000
LOGTO_RESOURCE=https://api.skanida.sch.id
LOGTO_POST_LOGOUT_REDIRECT_URI=http://192.168.21.121:15000/login

# Kiosk geolocation (SMKN 2 Magelang defaults)
KIOSK_LATITUDE=-7.44998
KIOSK_LONGITUDE=110.2236

# Retained only for database tooling/schema compatibility; attendance runtime
# never writes directly to PostgreSQL.
DATABASE_URL=postgresql://skanida:replace-with-a-unique-long-password@localhost:5432/skanida
